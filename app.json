{
  "expo": {
    "name": "SilverBack Sentry",
    "slug": "silverback-sentry",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2c5f2d"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.silverback.sentry",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "NSCameraUsageDescription": "SilverBack Sentry uses the camera to capture wildlife evidence photos and your profile picture.",
        "NSMicrophoneUsageDescription": "SilverBack Sentry records voice notes for wildlife reports.",
        "NSPhotoLibraryUsageDescription": "SilverBack Sentry lets you attach photos from your library to wildlife reports.",
        "NSLocationWhenInUseUsageDescription": "SilverBack Sentry tags reports and SOS alerts with your GPS position so rangers can respond."
      }
    },
    "android": {
      "package": "com.silverback.sentry",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#2c5f2d",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "USE_BIOMETRIC"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      "expo-image-picker",
      "expo-camera",
      "expo-location",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow SilverBack Sentry to record voice notes for wildlife reports."
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "798ce32d-838f-4b02-a514-9ff558ae595d"
      }
    }
  }
}
