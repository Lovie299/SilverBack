rules_version = '2';

// SilverBack Sentry — Firebase Storage rules.
// Report media (photos / voice notes) and avatars are written by signed-in
// users and readable by any signed-in user (rangers review evidence).
// Deploy with: firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    // Sighting & conflict-report evidence: sightings/{uid}/... , reports/...
    match /sightings/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 25 * 1024 * 1024;
    }

    match /reports/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024;
    }

    // Profile pictures: avatars/{uid}.jpg
    match /avatars/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
